# Public entry point for compose.prod.yaml. Caddy obtains and renews a
# Let's Encrypt certificate for $DOMAIN (its DNS A record must point at this
# server and ports 80/443 must be open) and redirects HTTP to HTTPS.
{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Backstop for the app's 20 MiB upload limit (MAX_PGN_UPLOAD_BYTES): reject
	# huge bodies before they reach Flask. Kept above the app limit plus
	# multipart overhead so Flask's own JSON error wins for borderline sizes.
	request_body {
		max_size 21MiB
	}

	reverse_proxy web:5000 {
		# Send bytes immediately: SSE results must not sit in a proxy buffer.
		flush_interval -1
	}
}
